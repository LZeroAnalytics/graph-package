specVersion: 0.0.5
schema:
  file: ./schema.graphql
dataSources:
  - kind: substreams
    name: TxStream
    network: {{.chain_key}}
    source:
      startBlock: {{.start_block}}
      package:
        moduleName: map_transactions
        file: ../substreams/{{.chain_key}}.spkg
    mapping:
      kind: substreams/graph-entities
      apiVersion: 0.0.7
      file: ./src/mapping.ts
      handler: handleBlock
